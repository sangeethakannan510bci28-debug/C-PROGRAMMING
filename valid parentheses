bool isValid(char* s) {
    int len = strlen(s);
    
    // An odd length string can never be valid
    if (len % 2 != 0) {
        return false;
    }
    
    // Allocate memory for the stack
    char* stack = (char*)malloc(len * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        char ch = s[i];
        
        // If it's an opening bracket, push it onto the stack
        if (ch == '(' || ch == '{' || ch == '[') {
            stack[++top] = ch;
        } 
        // If it's a closing bracket, check for a valid match
        else {
            // Stack is empty but we have a closing bracket -> invalid
            if (top == -1) {
                free(stack);
                return false;
            }
            
            char openBracket = stack[top--];
            if ((ch == ')' && openBracket != '(') ||
                (ch == '}' && openBracket != '{') ||
                (ch == ']' && openBracket != '[')) {
                free(stack);
                return false;
            }
        }
    }
    
    // If the stack is empty, all brackets were matched correctly
    bool valid = (top == -1);
    free(stack);
    return valid;
}
