#include <string.h>

int strStr(char* haystack, char* needle) {
    // Get the lengths of both strings
    int haystack_len = strlen(haystack);
    int needle_len = strlen(needle);

    // If the needle is longer than the haystack, it can't be a substring
    if (needle_len > haystack_len) {
        return -1;
    }

    // Iterate through the haystack up to the point where the needle can still fit
    for (int i = 0; i <= haystack_len - needle_len; i++) {
        int j;
        
        // Check if the substring starting at index i matches the needle
        for (j = 0; j < needle_len; j++) {
            if (haystack[i + j] != needle[j]) {
                break; // Characters mismatch, stop checking this position
            }
        }

        // If we completed the inner loop without breaking, we found a match
        if (j == needle_len) {
            return i;
        }
    }

    // Needle not found in haystack
    return -1;
}
