int removeElement(int* nums, int numsSize, int val) {
    int k = 0; // Slow pointer for valid elements
    
    for (int i = 0; i < numsSize; i++) {
        // If the current element is not the value to remove
        if (nums[i] != val) {
            nums[k] = nums[i]; // Move it to the front
            k++;               // Increment valid element count
        }
    }
    
    return k; // Return the total count of valid elements
}
