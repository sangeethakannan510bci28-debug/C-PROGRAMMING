#include <stdbool.h>

bool isSubsequence(char* s, char* t) {
    // Two pointers initialized to the start of each string
    int i = 0; // Pointer for string s
    int j = 0; // Pointer for string t

    // Traverse both strings until reaching the end of either
    while (s[i] != '\0' && t[j] != '\0') {
        // If characters match, move the pointer in s
        if (s[i] == t[j]) {
            i++;
        }
        // Always move the pointer in t
        j++;
    }

    // If i reached the end of s, then s is a subsequence of t
    return s[i] == '\0';
}
