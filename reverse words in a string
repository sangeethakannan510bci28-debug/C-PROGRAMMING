#include <string.h>

void reverse(char* s, int start, int end) {
    while (start < end) {
        char temp = s[start];
        s[start] = s[end];
        s[end] = temp;
        start++;
        end--;
    }
}

char* reverseWords(char* s) {
    int length = strlen(s);
    int word_start = 0;
    
    for (int i = 0; i <= length; i++) {
        // Find a space or the null-terminator marking the end of a word
        if (s[i] == ' ' || s[i] == '\0') {
            reverse(s, word_start, i - 1);
            word_start = i + 1; // Move start to the beginning of the next word
        }
    }
    
    return s;
}
