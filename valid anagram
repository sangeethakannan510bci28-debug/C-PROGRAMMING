bool isAnagram(char* s, char* t) {
    int arr[26];
    for(int i=0;i<26;i++){
        arr[i] = 0;
    }
    for(int i=0;i<strlen(s);i++){
        arr[s[i]-97]++;
    }
    for(int i=0;i<strlen(t);i++){
        arr[t[i]-97]--;
    }
    for(int i=0;i<26;i++){
        if(arr[i]!=0){
            return false;
        }
    }
    return true;
}
