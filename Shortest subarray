int minimumSubarrayLength(int* nums, int numsSize, int k) {
    int minLength = numsSize + 1; // Initialize with an impossible maximum length

    for (int i = 0; i < numsSize; i++) {
        int currentOr = 0;
        for (int j = i; j < numsSize; j++) {
            currentOr |= nums[j];
            
            // If the criteria is met, record the length and stop expanding this starting point
            if (currentOr >= k) {
                int length = j - i + 1;
                if (length < minLength) {
                    minLength = length;
                }
                break; 
            }
        }
    }

    // If minLength was never updated, it means no valid subarray exists
    return (minLength <= numsSize) ? minLength : -1;
}
