void duplicateZeros(int* arr, int arrSize) {
    int possibleDups = 0;
    int length_ = arrSize - 1;

    // First pass: Find the bounds and count how many zeros can be duplicated
    for (int left = 0; left <= length_ - possibleDups; left++) {
        if (arr[left] == 0) {
            // Edge case: This zero can fit but cannot be duplicated 
            // because there is no room left for the duplicate
            if (left == length_ - possibleDups) {
                arr[length_] = 0; // Copy it directly to the end
                length_ -= 1;
                break;
            }
            possibleDups++;
        }
    }

    // Second pass: Start from the end of the valid subarray and write backward
    int last = length_ - possibleDups;
    for (int i = last; i >= 0; i--) {
        if (arr[i] == 0) {
            arr[i + possibleDups] = 0;
            possibleDups--;
            arr[i + possibleDups] = 0;
        } else {
            arr[i + possibleDups] = arr[i];
        }
    }
}
