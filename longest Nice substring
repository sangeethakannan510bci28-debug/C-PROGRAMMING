#include <string.h>
#include <stdlib.h>
#include <stdbool.h>

// Helper function to recursively find the longest nice substring boundaries
void findNice(const char* s, int start, int end, int* maxStart, int* maxLen) {
    // Base case: a string of length less than 2 cannot be nice
    if (end - start + 1 <= 1) return;
    
    // Frequency array for ASCII characters
    int count[128] = {0};
    for (int i = start; i <= end; i++) {
        count[(unsigned char)s[i]]++;
    }
    
    // Check each character to find an invalid split point
    for (int i = start; i <= end; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') {
            if (count[c - 'a' + 'A'] == 0) { // Missing uppercase pair
                findNice(s, start, i - 1, maxStart, maxLen);
                findNice(s, i + 1, end, maxStart, maxLen);
                return;
            }
        } else if (c >= 'A' && c <= 'Z') {
            if (count[c - 'A' + 'a'] == 0) { // Missing lowercase pair
                findNice(s, start, i - 1, maxStart, maxLen);
                findNice(s, i + 1, end, maxStart, maxLen);
                return;
            }
        }
    }
    
    // If the loop finishes without returning, the entire substring is nice
    int len = end - start + 1;
    if (len > *maxLen) {
        *maxLen = len;
        *maxStart = start;
    }
}

char* longestNiceSubstring(char* s) {
    int len = strlen(s);
    int maxStart = 0;
    int maxLen = 0;
    
    // Find the indices of the longest nice substring
    findNice(s, 0, len - 1, &maxStart, &maxLen);
    
    // Dynamically allocate memory for the result string
    char* result = (char*)malloc((maxLen + 1) * sizeof(char));
    strncpy(result, s + maxStart, maxLen);
    result[maxLen] = '\0'; // Null-terminate the string
    
    return result;
}
