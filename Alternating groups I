int numberOfAlternatingGroups(int* colors, int colorsSize) {
    int count = 0;
    
    for (int i = 0; i < colorsSize; i++) {
        int prev = colors[(i - 1 + colorsSize) % colorsSize];
        int curr = colors[i];
        int next = colors[(i + 1) % colorsSize];
        
        // Check if the middle tile alternates with both neighbors
        if (curr != prev && curr != next) {
            count++;
        }
    }
    
    return count;
}
