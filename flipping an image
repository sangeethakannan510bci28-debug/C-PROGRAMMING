#include <stdlib.h>

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *returnColumnSizes array must be malloced, assume caller calls free().
 */
int** flipAndInvertImage(int** image, int imageSize, int* imageColSize, int* returnSize, int** returnColumnSizes) {
    // Set the return size (number of rows)
    *returnSize = imageSize;
    
    // Allocate memory for the array of column sizes
    *returnColumnSizes = (int*)malloc(imageSize * sizeof(int));
    
    // Allocate memory for the outer array of pointers (rows)
    int** result = (int**)malloc(imageSize * sizeof(int*));
    
    for (int i = 0; i < imageSize; i++) {
        int cols = imageColSize[i];
        (*returnColumnSizes)[i] = cols;
        
        // Allocate memory for the current row
        result[i] = (int*)malloc(cols * sizeof(int));
        
        // Flip and invert in a single pass
        for (int j = 0; j < cols; j++) {
            // Read from the opposite end of the original row and invert using XOR (^ 1)
            result[i][j] = image[i][cols - 1 - j] ^ 1;
        }
    }
    
    return result;
}
