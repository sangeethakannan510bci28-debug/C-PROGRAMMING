bool isLongPressedName(char* name, char* typed) {
    int i = 0;
    int j = 0;
    
    // Convert to string or check for null pointers safely if needed,
    // but assuming standard null-terminated C-strings:
    while (typed[j] != '\0') {
        if (name[i] != '\0' && name[i] == typed[j]) {
            i++;
            j++;
        } else if (j > 0 && typed[j] == typed[j - 1]) {
            j++;
        } else {
            return false;
        }
    }
    
    // The name is fully matched only if we reached the end of 'name' string
    return name[i] == '\0';
}
