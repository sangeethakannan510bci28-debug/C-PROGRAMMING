#include <stdlib.h>
#include <string.h>
#include <math.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* shortestToChar(char* s, char c, int* returnSize) {
    int n = strlen(s);
    *returnSize = n;
    
    int* answer = (int*)malloc(n * sizeof(int));
    if (answer == NULL) return NULL;

    // Use a large value representing "infinity" for initial states
    int prev = -100000; 

    // First pass: Left to Right
    for (int i = 0; i < n; i++) {
        if (s[i] == c) {
            prev = i;
        }
        answer[i] = i - prev;
    }

    // Second pass: Right to Left
    prev = 100000;
    for (int i = n - 1; i >= 0; i--) {
        if (s[i] == c) {
            prev = i;
        }
        // Take the minimum of the existing distance and the distance from the right
        if (prev - i < answer[i]) {
            answer[i] = prev - i;
        }
    }

    return answer;
}
