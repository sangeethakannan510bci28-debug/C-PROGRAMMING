#include <string.h>

char* reverseStr(char* s, int k) {
    int len = strlen(s);
    
    for (int i = 0; i < len; i += 2 * k) {
        // Find the boundary for reversal
        int left = i;
        int right = (i + k - 1 < len) ? (i + k - 1) : (len - 1);
        
        // Reverse the first k characters in the current 2k block
        while (left < right) {
            char temp = s[left];
            s[left] = s[right];
            s[right] = temp;
            left++;
            right--;
        }
    }
    
    return s;
}
