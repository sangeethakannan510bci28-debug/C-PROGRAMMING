#include <stdbool.h>
#include <string.h>

// Helper function to check if a substring is a perfect palindrome
bool isPalindromeRange(const char* s, int left, int right) {
    while (left < right) {
        if (s[left] != s[right]) {
            return false;
        }
        left++;
        right--;
    }
    return true;
}

bool validPalindrome(char* s) {
    int left = 0;
    int right = strlen(s) - 1;
    
    while (left < right) {
        if (s[left] != s[right]) {
            // Check if skipping s[left] OR skipping s[right] results in a palindrome
            return isPalindromeRange(s, left + 1, right) || isPalindromeRange(s, left, right - 1);
        }
        left++;
        right--;
    }
    
    return true;
}
