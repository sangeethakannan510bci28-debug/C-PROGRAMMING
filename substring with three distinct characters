#include <string.h>

int countGoodSubstrings(char* s) {
    int len = strlen(s);
    int count = 0;
    
    // Iterate through all possible substrings of length 3
    for (int i = 0; i <= len - 3; i++) {
        // Check if all three characters are distinct
        if (s[i] != s[i+1] && s[i] != s[i+2] && s[i+1] != s[i+2]) {
            count++;
        }
    }
    
    return count;
}
